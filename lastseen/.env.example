# Copy to .env for scripts (probe-omni, sim). For the Worker use apps/worker/.dev.vars
# (same keys) locally and `wrangler secret put <NAME>` when deployed. Never commit real values.

# --- OMNI (Huawei track, via sponsor proxy yibuapi) ---
OMNI_API_KEY=
OMNI_BASE_URL=https://yibuapi.com/v1
# Cheapest fast Omni variant that supports audio input; confirm with `pnpm probe:omni`
OMNI_MODEL=qwen3.5-omni-flash
# raw | datauri: how input_audio.data is encoded (the probe records which one the proxy accepts)
OMNI_AUDIO_STYLE=datauri

# 1 = canned schema-valid responses, fully offline (CI, sim)
MOCK_OMNI=1

# --- Worker ---
DEVICE_TOKEN=change-me
OMNI_BUDGET_CAP_CAD=30
RETENTION_HOURS=24
CAMERA_HFOV_DEG=70
STEP_LENGTH_M=0.7
# 1 = Workers AI embeddings + Vectorize; 0 = offline embeddings + SQLite (local wrangler dev has no Vectorize)
USE_VECTORIZE=1

# --- Ingest guards (defaults shown) ---
CANDIDATE_COOLDOWN_MS=4000
MAX_OMNI_PER_MIN=6
DEDUPE_WINDOW=10
WALK_FRACTION=0.5
# Crop the chosen object from the full-res still when it has at least this many pixels
CROP_MIN_PIXELS=1000000

# --- Optional remote detector: OFF unless DETECTOR_URL is set. Used only when a candidate has no detections. ---
DETECTOR_URL=
DETECTOR_SECRET=

# --- Sim / scripts: where the worker is running ---
LASTSEEN_URL=http://localhost:8787
