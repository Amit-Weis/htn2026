{
  "name": "lastseen",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "pnpm -r --if-present typecheck && tsc -p scripts/tsconfig.json",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "pnpm typecheck && pnpm lint && pnpm test",
    "build:web": "pnpm --filter @lastseen/wearable build && pnpm --filter @lastseen/dashboard build",
    "dev": "pnpm build:web && pnpm --filter @lastseen/worker dev",
    "deploy": "pnpm build:web && pnpm --filter @lastseen/worker deploy",
    "sim": "tsx tools/sim/src/run.ts",
    "probe:omni": "tsx scripts/probe-omni.ts",
    "sim:local": "pnpm build:web && tsx tools/sim/src/run.ts --spawn --all",
    "validate:native": "tsx scripts/validate-native.ts",
    "vectors": "tsx scripts/gen-vectors.ts",
    "unity:test": "node scripts/unity-check.mjs",
    "check:all": "pnpm check && pnpm sim:local",
    "android:doctor": "node scripts/android.mjs doctor",
    "android:build": "node scripts/android.mjs build",
    "android:test": "node scripts/android.mjs test",
    "android:install": "node scripts/android.mjs install",
    "android:run": "node scripts/android.mjs run",
    "android:logcat": "node scripts/android.mjs logcat",
    "android:probe": "node scripts/android.mjs probe",
    "android:report": "node scripts/android.mjs report"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@types/node": "^22.20.4",
    "eslint": "^10.11.0",
    "tsx": "^4.23.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.0",
    "vitest": "^3.2.7"
  }
}
